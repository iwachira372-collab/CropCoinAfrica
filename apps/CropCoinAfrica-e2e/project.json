{
  "name": "CropCoinAfrica-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["CropCoinAfrica"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "apps/CropCoinAfrica-e2e/jest.config.cts",
        "passWithNoTests": true
      },
      "dependsOn": ["CropCoinAfrica:build", "CropCoinAfrica:serve"]
    }
  }
}
